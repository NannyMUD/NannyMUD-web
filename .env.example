# Copy this file to .env and fill it in. .env stays out of git.

# The mud's FTP server, where the nightly export is fetched from
# (/www/export/ on the mud, readable by every wizard).
NANNY_FTP_HOST=mud.example.org
NANNY_FTP_PORT=2345

# A wizard's FTP login. Any wizard works.
NANNY_FTP_USER=yourwizard
NANNY_FTP_PASS=yourpassword

# The address and port the site and the wiki are served on. The default
# answers only on this machine, for a front proxy (nginx, Caddy) to use;
# 0.0.0.0 opens it to the network.
NANNY_HTTP_BIND=127.0.0.1
NANNY_HTTP_PORT=8080

# Where the site is served from: canonical links and the sitemap use it.
NANNY_SITE_URL=https://nanny.example.org

# When the builder fetches and rebuilds, mud time (after the 04:00 export).
NANNY_BUILD_AT=04:30

# The wiki's database. Pick a password; the installer asks for the same.
WIKI_DB_NAME=my_wiki
WIKI_DB_USER=wikiuser
WIKI_DB_PASSWORD=change-me

# The wiki's first administrator, made when the wiki is set up from
# empty. Not used when the live wiki is moved in (see README.md).
WIKI_NAME="NannyMUD Wiki"
WIKI_ADMIN_USER=Admin
WIKI_ADMIN_PASSWORD=change-me-too

# The wiki's nightly backup: a PRIVATE git repository (the database
# holds users' e-mail addresses and password hashes), pushed to with a
# deploy key saved as wiki/backup_key. Leave empty for no backups.
WIKI_BACKUP_REPO=
WIKI_BACKUP_AT=05:00
